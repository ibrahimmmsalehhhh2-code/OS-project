<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" alignment="TOP_CENTER" xmlns:fx="http://javafx.com/fxml" fx:controller="view.Input">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="CPU Scheduler Input" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10" alignment="CENTER">
        <Label text="Process ID:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="pIdField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Arrival Time:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="pArrivalField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Burst Time:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="pBurstField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Priority:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="pPriorityField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Add Process" onAction="#handleAddProcess" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
        <Button text="Clear All" onAction="#handleClear" style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
    </HBox>

    <TableView fx:id="inputTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID"/>
            <TableColumn fx:id="colArrival" text="Arrival"/>
            <TableColumn fx:id="colBurst" text="Burst"/>
            <TableColumn fx:id="colPriority" text="Priority"/>
        </columns>
    </TableView>

    <Button text="Run &amp; Compare Algorithms" onAction="#handleRun" prefWidth="200"
            style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 14px;"/>
</VBox>